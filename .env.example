# Obrigatório — o site não inicia sem esta variável
ADMIN_EMAIL=admin@anitabriza.org.br

# Senha inicial do usuário bootstrap (seed)
ADMIN_PASSWORD=Admin@123456

# Sessão (cookie httpOnly) — em produção: mín. 32 caracteres
JWT_SECRET=troque-este-segredo-em-producao-min-32-chars

# Porta do site (lida por npm run dev / iniciar.bat)
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# SQLite local (caminho relativo à pasta prisma/)
DATABASE_URL=file:./dev.db

# Google reCAPTCHA v2 ("Não sou um robô") — obrigatório
# https://www.google.com/recaptcha/admin
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
